{
  "name": "@open-charging-cloud/totp",
  "version": "0.3.0",
  "description": "Time-based one-time password generator for Open Charging Cloud applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenChargingCloud/TOTP.TS.git"
  },
  "bugs": {
    "url": "https://github.com/OpenChargingCloud/TOTP.TS/issues"
  },
  "homepage": "https://github.com/OpenChargingCloud/TOTP.TS#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "npm run build && vitest run",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prepack": "npm run test"
  },
  "keywords": [
    "totp",
    "otp",
    "time-based-one-time-password",
    "browser",
    "isomorphic",
    "open-charging-cloud"
  ],
  "author": "GraphDefined GmbH <achim.friedland@graphdefined.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
